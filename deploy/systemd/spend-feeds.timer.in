# Generated by scripts/service-install.sh — edit the template, not this.
#
# Jitter lives here rather than in Python: the Bridge asks that fetches be offset to a random
# minute, and a timer is the right place to express that. `Persistent=true` so a box that was
# asleep at 04:00 pulls when it wakes rather than skipping the day.
[Unit]
Description=Nightly spend statement pull

[Timer]
OnCalendar=*-*-* 04:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
