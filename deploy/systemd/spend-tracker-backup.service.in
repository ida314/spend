# Generated by scripts/service-install.sh — edit the template, not this.
[Unit]
Description=Back up the spend-tracker database and receipts

[Service]
Type=oneshot
# VACUUM INTO rather than a file copy: the database is in WAL mode, and copying the .db
# without its -wal alongside produces a file that opens cleanly and is missing the most
# recent writes — a backup that fails only when you need it.
ExecStart=/bin/sh -c 'mkdir -p %h/backups/spend-tracker && \
  @VENV@/bin/python -c "import sqlite3,sys; sqlite3.connect(sys.argv[1]).execute(\'VACUUM INTO ?\', (sys.argv[2],))" \
  %h/.local/share/spend-tracker/spendtracker.db %h/backups/spend-tracker/spendtracker.db.tmp && \
  mv %h/backups/spend-tracker/spendtracker.db.tmp %h/backups/spend-tracker/spendtracker.db && \
  rsync -a --delete %h/.local/share/spend-tracker/receipts/ %h/backups/spend-tracker/receipts/'
