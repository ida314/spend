# Generated by scripts/service-install.sh — edit the template, not this.
#
# The compose path runs the same command in a one-shot container; see compose.yaml.

[Unit]
Description=Back up the spend database and receipts

[Service]
Type=oneshot
# `spend backup` and not a file copy: the database is in WAL mode, and copying the .db
# without its -wal alongside produces a file that opens cleanly and is missing the most
# recent writes — a backup that fails only when you need it. See src/spend/backup.py.
ExecStart=@VENV@/bin/spend backup %h/backups/spend
